{
    "kind": "collectionType",
    "collectionName": "event_participants",
    "info": {
        "singularName": "event-participant",
        "pluralName": "event-participants",
        "displayName": "Người tham gia sự kiện"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "author": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "photo": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "description": {
            "type": "richtext",
            "customField": "global::tinymce",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "about": {
            "type": "richtext",
            "customField": "global::tinymce",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "items": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::event.event",
            "inversedBy": "participants"
        }
    }
}
