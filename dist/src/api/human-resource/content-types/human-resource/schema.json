{
    "kind": "collectionType",
    "collectionName": "human_resources",
    "info": {
        "singularName": "human-resource",
        "pluralName": "human-resources",
        "displayName": "Danh sách tuyển dụng"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "description": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "photo": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "active": {
            "type": "boolean",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "default": true
        },
        "content": {
            "type": "richtext",
            "customField": "global::tinymce",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name"
        },
        "category": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::category.category"
        }
    }
}
